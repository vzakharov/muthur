{
  "name": "muthur-artifacts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-warn-ignored .",
    "lint:fsd": "node scripts/lint-fsd.ts",
    "check:masd": "node scripts/masd-check.ts",
    "masd:clusters": "node scripts/masd-clusters.ts",
    "check:cycles": "madge --circular --no-spinner --extensions ts --ts-config tsconfig.json src",
    "test": "node --test",
    "review-board": "node src/review-board/scripts/build.ts"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "markdown-it": "14.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@steiger/toolkit": "0.2.3",
    "@types/estree": "1.0.10",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.69.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "jiti": "2.7.0",
    "madge": "8.0.0",
    "sass": "1.106.1",
    "steiger": "0.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
