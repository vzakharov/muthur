{
  "permissions": {
    "allow": [
      "Bash(scripts/pr-comment.sh *)",
      "Bash(./scripts/pr-comment.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/gh-shim.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/install-deps.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/operator-voice.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/start-telemetry-receiver.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh scripts/muthur-sync.sh nudge",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/estimate-notice.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/cold-cache/hooks/cold_cache.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/plan-mode-notice.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/session-images.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/prompt-issue-export.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/prompt-handle-pr-export.sh",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/prompt-route-notice.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/go-delegation.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/checkpoint-review.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/finalize-bash-gate.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/estimate-notice.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/cold-cache/hooks/cold_cache.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/merge-gate/hooks/merge_gate.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/keepalive/hooks/keepalive.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/file-tools-nudge.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/sticky-comment-nudge.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/stage-cost-row.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/checkpoint-review.py"
          }
        ]
      },
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/finalize-bash-gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__add_issue_comment|mcp__github__update_issue_comment",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/sticky-comment-nudge.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/go-delegation.py"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/checkpoint-review.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/format-md.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/context-budget/hooks/post-tool-context-budget.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/start-telemetry-receiver.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/permission-denied-phrase.sh mark"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/costs/hooks/stop-session-cost.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch.sh .claude/hooks/permission-denied-phrase.sh stop"
          }
        ]
      }
    ]
  }
}
